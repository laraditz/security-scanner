{
    "name": "laraditz/security-scanner",
    "description": "Laravel security vulnerability scanner",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "symfony/finder": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Laraditz\\SecurityScanner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laraditz\\SecurityScanner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraditz\\SecurityScanner\\SecurityScannerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
